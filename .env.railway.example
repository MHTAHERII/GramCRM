# Railway Deployment Configuration for GramCRM

## Environment Variables required on Railway
##
## Copy these to your Railway project → Settings → Variables

# === DATABASE (Auto-provided by Railway PostgreSQL Plugin) ===
# DATABASE_URL      <-- Set automatically by Railway when you add a PostgreSQL service

# === REQUIRED: Zernio API credentials ===
ZERNIO_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ZERNIO_PROFILE_ID=xxxxxxxxxxxxxxxxxxxxxx
ZERNIO_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxx

# === REQUIRED: Panel admin password and session secret ===
ADMIN_PASSWORD=your_strong_admin_password_here
ADMIN_SESSION_SECRET=change-this-to-a-very-long-random-string-keep-it-secret

# === OPTIONAL: Zernio webhook verification ===
META_VERIFY_TOKEN=perfume_bot_verify_token_2026

# === OPTIONAL: Instagram DM worker ===
ENABLE_IG_WORKER=true
IG_POLL_INTERVAL=5
