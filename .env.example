# ==========================================
# تنظیمات محیطی GramCRM برای استقرار در Railway
# ==========================================

# ۱. دیتابیس (اگر در Railway افزونه PostgreSQL را اضافه کنید، این متغیر خودکار پر می‌شود)
# DATABASE_URL=postgresql://postgres:password@host:port/railway

# ۲. اطلاعات امنیتی ورود به پنل
# هشدار: هرگز مقادیر پیش‌فرض را روی سرور عملیاتی نگذارید
ADMIN_PASSWORD=replace_with_a_strong_password
ADMIN_SESSION_SECRET=replace_with_a_long_random_secret

# ۳. تنظیمات Zernio (رابط رسمی اینستاگرام)
ZERNIO_API_KEY=replace_with_your_zernio_api_key
ZERNIO_PROFILE_ID=replace_with_your_profile_id
ZERNIO_ACCOUNT_ID=replace_with_your_account_id

# ۴. امنیت وب‌هوک‌ها (اختیاری ولی توصیه‌شده)
# امضای وب‌هوک متا: App Secret اپلیکیشن Meta (HMAC-SHA256)
META_APP_SECRET=
# توکن وب‌هوک زرنیو: درخواست‌ها باید هدر X-Zernio-Webhook-Token را داشته باشند
ZERNIO_WEBHOOK_SECRET=

# ۴. ورکر پردازش دایرکت‌ها
ENABLE_IG_WORKER=true
IG_POLL_INTERVAL=5

# ۵. توکن‌های وب‌هوک
META_VERIFY_TOKEN=replace_with_a_random_verify_token
